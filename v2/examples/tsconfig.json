{
  "compilerOptions": {
    "target": "es2024",
    "lib": [
      "es2024",
      "esnext.disposable"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "paths": {
      "wallis": [
        "../lib/src/index.ts"
      ],
      "wallis/testing": [
        "../lib/src/testing.ts"
      ]
    },
    "skipLibCheck": true
  },
  "include": [
    "film",
    "chat",
    "siderius"
  ]
}
