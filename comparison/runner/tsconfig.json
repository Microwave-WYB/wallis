{
  "compilerOptions": {
    "target": "es2022",
    "lib": [
      "es2022",
      "esnext.disposable"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": [
    "*.ts",
    "lib"
  ],
  "exclude": [
    "node_modules",
    "out",
    "work"
  ]
}
