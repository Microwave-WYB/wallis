//// Wire types: everything that crosses the JS boundary as JSON. Decoders
//// and encoders below are generated by the Gleam language server code
//// actions (see tools/gleam-codegen.mjs); only references to nested types
//// were filled in by hand where the action left a `todo`.

import gleam/dict.{type Dict}
import gleam/dynamic/decode
import gleam/json
import gleam/option.{type Option}
import wallis_core/value.{type Value} as json_value

// --- Declarations (produced by the TS SDK) ---------------------------------

pub type Workflow {
  Workflow(
    name: String,
    fields: List(Field),
    agents: List(Agent),
    scripts: List(String),
    budget: Budget,
  )
}

pub fn workflow_to_json(workflow: Workflow) -> json.Json {
  let Workflow(name:, fields:, agents:, scripts:, budget:) = workflow
  json.object([
    #("name", json.string(name)),
    #("fields", json.array(fields, field_to_json)),
    #("agents", json.array(agents, agent_to_json)),
    #("scripts", json.array(scripts, json.string)),
    #("budget", budget_to_json(budget)),
  ])
}

pub fn workflow_decoder() -> decode.Decoder(Workflow) {
  use name <- decode.field("name", decode.string)
  use fields <- decode.field("fields", decode.list(field_decoder()))
  use agents <- decode.field("agents", decode.list(agent_decoder()))
  use scripts <- decode.field("scripts", decode.list(decode.string))
  use budget <- decode.field("budget", budget_decoder())
  decode.success(Workflow(name:, fields:, agents:, scripts:, budget:))
}

pub type Field {
  Field(name: String, reducer: Reducer, initial: Value)
}

pub fn field_to_json(field: Field) -> json.Json {
  let Field(name:, reducer:, initial:) = field
  json.object([
    #("name", json.string(name)),
    #("reducer", reducer_to_json(reducer)),
    #("initial", json_value.to_json(initial)),
  ])
}

pub fn field_decoder() -> decode.Decoder(Field) {
  use name <- decode.field("name", decode.string)
  use reducer <- decode.field("reducer", reducer_decoder())
  use initial <- decode.field("initial", json_value.decoder())
  decode.success(Field(name:, reducer:, initial:))
}

pub type Reducer {
  Replace
  Append
  Union
  Sum
  CountByKey
  TopK(
    k: Int,
    by: String,
    order: Direction,
    key: Option(String),
    latest: Latest,
  )
  AppendByKey(key: String)
  Freeze
  LlmMerge(agent: String, max: Int, max_calls: Int, archive: Option(String))
}

pub fn reducer_to_json(reducer: Reducer) -> json.Json {
  case reducer {
    Replace ->
      json.object([
        #("type", json.string("replace")),
      ])
    Append ->
      json.object([
        #("type", json.string("append")),
      ])
    Union ->
      json.object([
        #("type", json.string("union")),
      ])
    Sum ->
      json.object([
        #("type", json.string("sum")),
      ])
    CountByKey ->
      json.object([
        #("type", json.string("count_by_key")),
      ])
    TopK(k:, by:, order:, key:, latest:) ->
      json.object([
        #("type", json.string("top_k")),
        #("k", json.int(k)),
        #("by", json.string(by)),
        #("order", direction_to_json(order)),
        #("key", case key {
          option.None -> json.null()
          option.Some(value) -> json.string(value)
        }),
        #("latest", latest_to_json(latest)),
      ])
    AppendByKey(key:) ->
      json.object([
        #("type", json.string("append_by_key")),
        #("key", json.string(key)),
      ])
    Freeze ->
      json.object([
        #("type", json.string("freeze")),
      ])
    LlmMerge(agent:, max:, max_calls:, archive:) ->
      json.object([
        #("type", json.string("llm_merge")),
        #("agent", json.string(agent)),
        #("max", json.int(max)),
        #("max_calls", json.int(max_calls)),
        #("archive", case archive {
          option.None -> json.null()
          option.Some(value) -> json.string(value)
        }),
      ])
  }
}

pub fn reducer_decoder() -> decode.Decoder(Reducer) {
  use variant <- decode.field("type", decode.string)
  case variant {
    "replace" -> decode.success(Replace)
    "append" -> decode.success(Append)
    "union" -> decode.success(Union)
    "sum" -> decode.success(Sum)
    "count_by_key" -> decode.success(CountByKey)
    "top_k" -> {
      use k <- decode.field("k", decode.int)
      use by <- decode.field("by", decode.string)
      use order <- decode.field("order", direction_decoder())
      use key <- decode.field("key", decode.optional(decode.string))
      use latest <- decode.field("latest", latest_decoder())
      decode.success(TopK(k:, by:, order:, key:, latest:))
    }
    "append_by_key" -> {
      use key <- decode.field("key", decode.string)
      decode.success(AppendByKey(key:))
    }
    "freeze" -> decode.success(Freeze)
    "llm_merge" -> {
      use agent <- decode.field("agent", decode.string)
      use max <- decode.field("max", decode.int)
      use max_calls <- decode.field("max_calls", decode.int)
      use archive <- decode.field("archive", decode.optional(decode.string))
      decode.success(LlmMerge(agent:, max:, max_calls:, archive:))
    }
    _ -> decode.failure(Replace, "Reducer")
  }
}

pub type Direction {
  Ascending
  Descending
}

pub fn direction_to_json(direction: Direction) -> json.Json {
  case direction {
    Ascending -> json.string("ascending")
    Descending -> json.string("descending")
  }
}

pub fn direction_decoder() -> decode.Decoder(Direction) {
  use variant <- decode.then(decode.string)
  case variant {
    "ascending" -> decode.success(Ascending)
    "descending" -> decode.success(Descending)
    _ -> decode.failure(Ascending, "Direction")
  }
}

pub type Latest {
  KeepLatest
  TopOnly
}

pub fn latest_to_json(latest: Latest) -> json.Json {
  case latest {
    KeepLatest -> json.string("keep_latest")
    TopOnly -> json.string("top_only")
  }
}

pub fn latest_decoder() -> decode.Decoder(Latest) {
  use variant <- decode.then(decode.string)
  case variant {
    "keep_latest" -> decode.success(KeepLatest)
    "top_only" -> decode.success(TopOnly)
    _ -> decode.failure(KeepLatest, "Latest")
  }
}

pub type Agent {
  Agent(
    name: String,
    model: String,
    view: ViewSpec,
    writes: List(WriteMap),
    max_turns: Int,
  )
}

pub fn agent_to_json(agent: Agent) -> json.Json {
  let Agent(name:, model:, view:, writes:, max_turns:) = agent
  json.object([
    #("name", json.string(name)),
    #("model", json.string(model)),
    #("view", view_spec_to_json(view)),
    #("writes", json.array(writes, write_map_to_json)),
    #("max_turns", json.int(max_turns)),
  ])
}

pub fn agent_decoder() -> decode.Decoder(Agent) {
  use name <- decode.field("name", decode.string)
  use model <- decode.field("model", decode.string)
  use view <- decode.field("view", view_spec_decoder())
  use writes <- decode.field("writes", decode.list(write_map_decoder()))
  use max_turns <- decode.field("max_turns", decode.int)
  decode.success(Agent(name:, model:, view:, writes:, max_turns:))
}

/// `from` is a dotted path into the agent output. `None` admits writes to
/// `field` through the executor's `emit` tool only.
pub type WriteMap {
  WriteMap(field: String, from: Option(String))
}

pub fn write_map_to_json(write_map: WriteMap) -> json.Json {
  let WriteMap(field:, from:) = write_map
  json.object([
    #("field", json.string(field)),
    #("from", case from {
      option.None -> json.null()
      option.Some(value) -> json.string(value)
    }),
  ])
}

pub fn write_map_decoder() -> decode.Decoder(WriteMap) {
  use field <- decode.field("field", decode.string)
  use from <- decode.field("from", decode.optional(decode.string))
  decode.success(WriteMap(field:, from:))
}

pub type ViewSpec {
  ViewSpec(
    fields: List(String),
    max_chars: Int,
    max_items: Int,
    chunk: Int,
    omit: List(String),
  )
}

pub fn view_spec_to_json(view_spec: ViewSpec) -> json.Json {
  let ViewSpec(fields:, max_chars:, max_items:, chunk:, omit:) = view_spec
  json.object([
    #("fields", json.array(fields, json.string)),
    #("max_chars", json.int(max_chars)),
    #("max_items", json.int(max_items)),
    #("chunk", json.int(chunk)),
    #("omit", json.array(omit, json.string)),
  ])
}

pub fn view_spec_decoder() -> decode.Decoder(ViewSpec) {
  use fields <- decode.field("fields", decode.list(decode.string))
  use max_chars <- decode.field("max_chars", decode.int)
  use max_items <- decode.field("max_items", decode.int)
  use chunk <- decode.field("chunk", decode.int)
  use omit <- decode.field("omit", decode.list(decode.string))
  decode.success(ViewSpec(fields:, max_chars:, max_items:, chunk:, omit:))
}

pub type Budget {
  Budget(
    usd: Option(Float),
    tokens: Option(Int),
    turns: Option(Int),
    compute_minutes: Option(Float),
  )
}

pub fn budget_to_json(budget: Budget) -> json.Json {
  let Budget(usd:, tokens:, turns:, compute_minutes:) = budget
  json.object([
    #("usd", case usd {
      option.None -> json.null()
      option.Some(value) -> json.float(value)
    }),
    #("tokens", case tokens {
      option.None -> json.null()
      option.Some(value) -> json.int(value)
    }),
    #("turns", case turns {
      option.None -> json.null()
      option.Some(value) -> json.int(value)
    }),
    #("compute_minutes", case compute_minutes {
      option.None -> json.null()
      option.Some(value) -> json.float(value)
    }),
  ])
}

pub fn budget_decoder() -> decode.Decoder(Budget) {
  use usd <- decode.field("usd", decode.optional(decode.float))
  use tokens <- decode.field("tokens", decode.optional(decode.int))
  use turns <- decode.field("turns", decode.optional(decode.int))
  use compute_minutes <- decode.field(
    "compute_minutes",
    decode.optional(decode.float),
  )
  decode.success(Budget(usd:, tokens:, turns:, compute_minutes:))
}

pub type Pin {
  Pin(
    workflow_digest: String,
    models: Dict(String, String),
    seed: Int,
    inputs: Dict(String, String),
  )
}

pub fn pin_to_json(pin: Pin) -> json.Json {
  let Pin(workflow_digest:, models:, seed:, inputs:) = pin
  json.object([
    #("workflow_digest", json.string(workflow_digest)),
    #("models", json.dict(models, fn(string) { string }, json.string)),
    #("seed", json.int(seed)),
    #("inputs", json.dict(inputs, fn(string) { string }, json.string)),
  ])
}

pub fn pin_decoder() -> decode.Decoder(Pin) {
  use workflow_digest <- decode.field("workflow_digest", decode.string)
  use models <- decode.field(
    "models",
    decode.dict(decode.string, decode.string),
  )
  use seed <- decode.field("seed", decode.int)
  use inputs <- decode.field(
    "inputs",
    decode.dict(decode.string, decode.string),
  )
  decode.success(Pin(workflow_digest:, models:, seed:, inputs:))
}

// --- Events (host to core) ---------------------------------------------------

pub type Event {
  Started(workflow: Workflow, pin: Pin, input: Value)
  Resumed(pin: Pin)
  Requested(id: String, branch: Option(String), request: Request)
  AgentReturned(id: String, output: Value, emits: List(Write), usage: Usage)
  AgentFailed(id: String, error: String, usage: Usage)
  ScriptReturned(id: String, output: Value, minutes: Float)
  ScriptFailed(id: String, error: String, minutes: Float)
  BodyFinished(output: Value)
  BodyFailed(error: String)
}

pub fn event_to_json(event: Event) -> json.Json {
  case event {
    Started(workflow:, pin:, input:) ->
      json.object([
        #("type", json.string("started")),
        #("workflow", workflow_to_json(workflow)),
        #("pin", pin_to_json(pin)),
        #("input", json_value.to_json(input)),
      ])
    Resumed(pin:) ->
      json.object([
        #("type", json.string("resumed")),
        #("pin", pin_to_json(pin)),
      ])
    Requested(id:, branch:, request:) ->
      json.object([
        #("type", json.string("requested")),
        #("id", json.string(id)),
        #("branch", case branch {
          option.None -> json.null()
          option.Some(value) -> json.string(value)
        }),
        #("request", request_to_json(request)),
      ])
    AgentReturned(id:, output:, emits:, usage:) ->
      json.object([
        #("type", json.string("agent_returned")),
        #("id", json.string(id)),
        #("output", json_value.to_json(output)),
        #("emits", json.array(emits, write_to_json)),
        #("usage", usage_to_json(usage)),
      ])
    AgentFailed(id:, error:, usage:) ->
      json.object([
        #("type", json.string("agent_failed")),
        #("id", json.string(id)),
        #("error", json.string(error)),
        #("usage", usage_to_json(usage)),
      ])
    ScriptReturned(id:, output:, minutes:) ->
      json.object([
        #("type", json.string("script_returned")),
        #("id", json.string(id)),
        #("output", json_value.to_json(output)),
        #("minutes", json.float(minutes)),
      ])
    ScriptFailed(id:, error:, minutes:) ->
      json.object([
        #("type", json.string("script_failed")),
        #("id", json.string(id)),
        #("error", json.string(error)),
        #("minutes", json.float(minutes)),
      ])
    BodyFinished(output:) ->
      json.object([
        #("type", json.string("body_finished")),
        #("output", json_value.to_json(output)),
      ])
    BodyFailed(error:) ->
      json.object([
        #("type", json.string("body_failed")),
        #("error", json.string(error)),
      ])
  }
}

pub fn event_decoder() -> decode.Decoder(Event) {
  use variant <- decode.field("type", decode.string)
  case variant {
    "started" -> {
      use workflow <- decode.field("workflow", workflow_decoder())
      use pin <- decode.field("pin", pin_decoder())
      use input <- decode.field("input", json_value.decoder())
      decode.success(Started(workflow:, pin:, input:))
    }
    "resumed" -> {
      use pin <- decode.field("pin", pin_decoder())
      decode.success(Resumed(pin:))
    }
    "requested" -> {
      use id <- decode.field("id", decode.string)
      use branch <- decode.field("branch", decode.optional(decode.string))
      use request <- decode.field("request", request_decoder())
      decode.success(Requested(id:, branch:, request:))
    }
    "agent_returned" -> {
      use id <- decode.field("id", decode.string)
      use output <- decode.field("output", json_value.decoder())
      use emits <- decode.field("emits", decode.list(write_decoder()))
      use usage <- decode.field("usage", usage_decoder())
      decode.success(AgentReturned(id:, output:, emits:, usage:))
    }
    "agent_failed" -> {
      use id <- decode.field("id", decode.string)
      use error <- decode.field("error", decode.string)
      use usage <- decode.field("usage", usage_decoder())
      decode.success(AgentFailed(id:, error:, usage:))
    }
    "script_returned" -> {
      use id <- decode.field("id", decode.string)
      use output <- decode.field("output", json_value.decoder())
      use minutes <- decode.field("minutes", decode.float)
      decode.success(ScriptReturned(id:, output:, minutes:))
    }
    "script_failed" -> {
      use id <- decode.field("id", decode.string)
      use error <- decode.field("error", decode.string)
      use minutes <- decode.field("minutes", decode.float)
      decode.success(ScriptFailed(id:, error:, minutes:))
    }
    "body_finished" -> {
      use output <- decode.field("output", json_value.decoder())
      decode.success(BodyFinished(output:))
    }
    "body_failed" -> {
      use error <- decode.field("error", decode.string)
      decode.success(BodyFailed(error:))
    }
    _ ->
      decode.failure(
        Resumed(pin: Pin(
          workflow_digest: "",
          models: dict.new(),
          seed: 0,
          inputs: dict.new(),
        )),
        "Event",
      )
  }
}

pub type Request {
  Call(agent: String, input: Value)
  Script(script: String, args: Value)
  Read(view: ViewSpec)
  Commit(writes: List(Write))
}

pub fn request_to_json(request: Request) -> json.Json {
  case request {
    Call(agent:, input:) ->
      json.object([
        #("type", json.string("call")),
        #("agent", json.string(agent)),
        #("input", json_value.to_json(input)),
      ])
    Script(script:, args:) ->
      json.object([
        #("type", json.string("script")),
        #("script", json.string(script)),
        #("args", json_value.to_json(args)),
      ])
    Read(view:) ->
      json.object([
        #("type", json.string("read")),
        #("view", view_spec_to_json(view)),
      ])
    Commit(writes:) ->
      json.object([
        #("type", json.string("commit")),
        #("writes", json.array(writes, write_to_json)),
      ])
  }
}

pub fn request_decoder() -> decode.Decoder(Request) {
  use variant <- decode.field("type", decode.string)
  case variant {
    "call" -> {
      use agent <- decode.field("agent", decode.string)
      use input <- decode.field("input", json_value.decoder())
      decode.success(Call(agent:, input:))
    }
    "script" -> {
      use script <- decode.field("script", decode.string)
      use args <- decode.field("args", json_value.decoder())
      decode.success(Script(script:, args:))
    }
    "read" -> {
      use view <- decode.field("view", view_spec_decoder())
      decode.success(Read(view:))
    }
    "commit" -> {
      use writes <- decode.field("writes", decode.list(write_decoder()))
      decode.success(Commit(writes:))
    }
    _ ->
      decode.failure(
        Read(
          view: ViewSpec(
            fields: [],
            max_chars: 0,
            max_items: 0,
            chunk: 0,
            omit: [],
          ),
        ),
        "Request",
      )
  }
}

pub type Write {
  Write(field: String, value: Value)
}

pub fn write_to_json(write: Write) -> json.Json {
  let Write(field:, value:) = write
  json.object([
    #("field", json.string(field)),
    #("value", json_value.to_json(value)),
  ])
}

pub fn write_decoder() -> decode.Decoder(Write) {
  use field <- decode.field("field", decode.string)
  use value <- decode.field("value", json_value.decoder())
  decode.success(Write(field:, value:))
}

pub type Usage {
  Usage(usd: Float, tokens: Int, turns: Int)
}

pub fn usage_to_json(usage: Usage) -> json.Json {
  let Usage(usd:, tokens:, turns:) = usage
  json.object([
    #("usd", json.float(usd)),
    #("tokens", json.int(tokens)),
    #("turns", json.int(turns)),
  ])
}

pub fn usage_decoder() -> decode.Decoder(Usage) {
  use usd <- decode.field("usd", decode.float)
  use tokens <- decode.field("tokens", decode.int)
  use turns <- decode.field("turns", decode.int)
  decode.success(Usage(usd:, tokens:, turns:))
}

// --- Effects (core to host) --------------------------------------------------

pub type Effect {
  /// Append the event just stepped to the log.
  Checkpoint
  CallAgent(
    id: String,
    agent: String,
    model: String,
    view: String,
    omitted: Dict(String, Int),
    input: Value,
    max_turns: Int,
    digest: String,
  )
  RunScript(
    id: String,
    script: String,
    args: Value,
    compute_minutes: Option(Float),
    digest: String,
  )
  Deliver(id: String, value: Value)
  Fail(id: String, error: String)
  Refuse(id: Option(String), reason: String)
  Finish(outcome: Outcome)
}

pub fn effect_to_json(effect: Effect) -> json.Json {
  case effect {
    Checkpoint ->
      json.object([
        #("type", json.string("checkpoint")),
      ])
    CallAgent(id:, agent:, model:, view:, omitted:, input:, max_turns:, digest:) ->
      json.object([
        #("type", json.string("call_agent")),
        #("id", json.string(id)),
        #("agent", json.string(agent)),
        #("model", json.string(model)),
        #("view", json.string(view)),
        #("omitted", json.dict(omitted, fn(string) { string }, json.int)),
        #("input", json_value.to_json(input)),
        #("max_turns", json.int(max_turns)),
        #("digest", json.string(digest)),
      ])
    RunScript(id:, script:, args:, compute_minutes:, digest:) ->
      json.object([
        #("type", json.string("run_script")),
        #("id", json.string(id)),
        #("script", json.string(script)),
        #("args", json_value.to_json(args)),
        #("compute_minutes", case compute_minutes {
          option.None -> json.null()
          option.Some(value) -> json.float(value)
        }),
        #("digest", json.string(digest)),
      ])
    Deliver(id:, value:) ->
      json.object([
        #("type", json.string("deliver")),
        #("id", json.string(id)),
        #("value", json_value.to_json(value)),
      ])
    Fail(id:, error:) ->
      json.object([
        #("type", json.string("fail")),
        #("id", json.string(id)),
        #("error", json.string(error)),
      ])
    Refuse(id:, reason:) ->
      json.object([
        #("type", json.string("refuse")),
        #("id", case id {
          option.None -> json.null()
          option.Some(value) -> json.string(value)
        }),
        #("reason", json.string(reason)),
      ])
    Finish(outcome:) ->
      json.object([
        #("type", json.string("finish")),
        #("outcome", outcome_to_json(outcome)),
      ])
  }
}

pub fn effect_decoder() -> decode.Decoder(Effect) {
  use variant <- decode.field("type", decode.string)
  case variant {
    "checkpoint" -> decode.success(Checkpoint)
    "call_agent" -> {
      use id <- decode.field("id", decode.string)
      use agent <- decode.field("agent", decode.string)
      use model <- decode.field("model", decode.string)
      use view <- decode.field("view", decode.string)
      use omitted <- decode.field(
        "omitted",
        decode.dict(decode.string, decode.int),
      )
      use input <- decode.field("input", json_value.decoder())
      use max_turns <- decode.field("max_turns", decode.int)
      use digest <- decode.field("digest", decode.string)
      decode.success(CallAgent(
        id:,
        agent:,
        model:,
        view:,
        omitted:,
        input:,
        max_turns:,
        digest:,
      ))
    }
    "run_script" -> {
      use id <- decode.field("id", decode.string)
      use script <- decode.field("script", decode.string)
      use args <- decode.field("args", json_value.decoder())
      use compute_minutes <- decode.field(
        "compute_minutes",
        decode.optional(decode.float),
      )
      use digest <- decode.field("digest", decode.string)
      decode.success(RunScript(id:, script:, args:, compute_minutes:, digest:))
    }
    "deliver" -> {
      use id <- decode.field("id", decode.string)
      use value <- decode.field("value", json_value.decoder())
      decode.success(Deliver(id:, value:))
    }
    "fail" -> {
      use id <- decode.field("id", decode.string)
      use error <- decode.field("error", decode.string)
      decode.success(Fail(id:, error:))
    }
    "refuse" -> {
      use id <- decode.field("id", decode.optional(decode.string))
      use reason <- decode.field("reason", decode.string)
      decode.success(Refuse(id:, reason:))
    }
    "finish" -> {
      use outcome <- decode.field("outcome", outcome_decoder())
      decode.success(Finish(outcome:))
    }
    _ -> decode.failure(Checkpoint, "Effect")
  }
}

pub type Outcome {
  Done(value: Value)
  Failed(error: String)
}

pub fn outcome_to_json(outcome: Outcome) -> json.Json {
  case outcome {
    Done(value:) ->
      json.object([
        #("type", json.string("done")),
        #("value", json_value.to_json(value)),
      ])
    Failed(error:) ->
      json.object([
        #("type", json.string("failed")),
        #("error", json.string(error)),
      ])
  }
}

pub fn outcome_decoder() -> decode.Decoder(Outcome) {
  use variant <- decode.field("type", decode.string)
  case variant {
    "done" -> {
      use value <- decode.field("value", json_value.decoder())
      decode.success(Done(value:))
    }
    "failed" -> {
      use error <- decode.field("error", decode.string)
      decode.success(Failed(error:))
    }
    _ -> decode.failure(Done(value: json_value.JNull), "Outcome")
  }
}
