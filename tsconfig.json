{
  "compilerOptions": {
    "target": "es2024",
    "lib": [
      "es2024",
      "esnext.disposable"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "allowJs": false,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "wallis": [
        "./src/index.ts"
      ],
      "wallis/testing": [
        "./src/testing.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "examples",
    "skills"
  ]
}
