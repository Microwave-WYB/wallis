{
  "name": "wallis",
  "version": "0.0.0",
  "private": true,
  "description": "wallis SDK (workflow declarations) and thin host (runs the core, executes effects)",
  "type": "module",
  "exports": {
    ".": "./src/sdk/index.ts",
    "./host": "./src/host/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p ../.agents/workflows",
    "test": "node --test 'test/*.test.ts'"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.5.0",
    "@earendil-works/pi-ai": "1.5.0",
    "@earendil-works/pi-codemode": "1.5.0",
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@earendil-works/pi-mcp": "1.5.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "esbuild": "0.28.2",
    "quickjs-wasi": "3.6.2",
    "typebox": "1.3.27",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  },
  "bin": {
    "wallis": "./src/cli/main.ts"
  }
}
